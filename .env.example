# Copy to .env and fill in to enable LLM-narrated exception explanations.
# Without this, the explainer falls back to deterministic per-reason-code
# templates -- all numbers, match rates, and metrics are identical either way.
ANTHROPIC_API_KEY=sk-ant-...

# Required only if your key is an "identity-linked" API key
# (console -> Settings -> Workspaces -> the workspace's ID)
# ANTHROPIC_WORKSPACE_ID=

# Optional -- override the narration model (default: claude-sonnet-5)
# LEDGERLOCK_AI_MODEL=claude-sonnet-5
